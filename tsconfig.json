{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": false,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "jsx": "react-jsx",
    "paths": {
      "@trailofdad/morphkit-calculator": ["./src/index.ts"],
      "@trailofdad/morphkit-calculator/react": ["./src/react/index.ts"]
    },
    "types": ["node"]
  },
  "include": ["src", "tests", "playground", "tsup.config.ts", "vitest.config.ts"]
}
