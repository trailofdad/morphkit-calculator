{
  "name": "@trailofdad/morphkit-calculator",
  "version": "0.1.0",
  "description": "Ball python breeding calculator built on morphkit: parent selection, zygosity, folded outcomes and morph labels.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "https://github.com/trailofdad/morphkit-calculator.git"
  },
  "homepage": "https://github.com/trailofdad/morphkit-calculator#readme",
  "bugs": {
    "url": "https://github.com/trailofdad/morphkit-calculator/issues"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src tests",
    "format": "prettier --write .",
    "check:clean-tree": "node scripts/assert-clean-tree.mjs",
    "prepublishOnly": "npm run check:clean-tree && npm run typecheck && npm test && npm run build"
  },
  "keywords": [
    "genetics",
    "reptile",
    "ball-python",
    "morphology",
    "calculator"
  ],
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "peerDependencies": {
    "@trailofdad/morphkit": "^0.3.0"
  },
  "devDependencies": {
    "@trailofdad/morphkit": "^0.3.1",
    "@types/node": "^22.20.5",
    "@vitest/coverage-v8": "^4.1.8",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^10.0.0",
    "eslint-plugin-prettier": "^5.0.0",
    "prettier": "^3.0.0",
    "tsup": "^8.5.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^4.1.8"
  }
}
